
type Mat4(float, float, float, float)

--let input = Mat4(i._0, i._1, i._2, i._3)
--let neuron = Mat4(n._0, n._1, n._2, n._3)
  
--let output = Mat4(p_0, p_1, p_2, p_3)
--let truth = Mat4(t_0,t_1, t_2, t_3)

Basis  k_0, ..., k_{N-1}  with multiplication rules


k_i * k_i  =  k_{(i + 1) mod N}     (squaring)
k_i * k_j  =  k_{(2i + j) mod N}    (mixed products, i ≠ j)

k_n^2 => k_{n+1}
k_{max}^2 => k_0

┌───────────────┬──────────┬──────────────┬────────────────┬────────────────────────────┐
│ Half-exponent │ 0^(z/2)  │ Square = 0^z │ Imaginary unit │          Algebra           │
├───────────────┼──────────┼──────────────┼────────────────┼────────────────────────────┤
│ z/2 = 0       │ 1        │ 0^0  = +1    │ j, j² = +1     │ split-complex / hyperbolic │
├───────────────┼──────────┼──────────────┼────────────────┼────────────────────────────┤
│ z/2 = 1/2     │ 0^(1/2)  │ 0^1  =  0    │ ε, ε² =  0     │ dual / parabolic           │
├───────────────┼──────────┼──────────────┼────────────────┼────────────────────────────┤
│ z/2 = −1/2    │ 0^(−1/2) │ 0^(−1)= ω    │ k, k² =  ω     │ ω-imaginary (new)          │
├───────────────┼──────────┼──────────────┼────────────────┼────────────────────────────┤
│ z/2 = ω/2     │ 0^(ω/2)  │ 0^ω  = −1    │ i, i² = −1     │ complex / elliptic         │
└───────────────┴──────────┴──────────────┴────────────────┴────────────────────────────┘



let i = Tracternion(input)
let n = Tracternion(neuron)

let p_0 = i._1*n._2 + i._2*n._0 + i._3*n._2 + i._3*n._3
let p_1 = i._0*n._0 + i._0*n._1 + i._1*n._3 + i._2*n._1
let p_2 = i._0*n._2 + i._1*n._0 + i._1*n._1 + i._3*n._0
let p_3 = i._0*n._3 + i._2*n._2 + i._2*n._3 + i._3*n._1

let output = Tracternion(p_0, p_1, p_2, p_3)


-- Square
let p_0 = n._3*n._3 + n._2*(n._0 + n._1 + n._3)
let p_1 = n._0*n._0 + n._1*(n._0 + n._2 + n._3)
let p_2 = n._1*n._1 + n._0*(n._1 + n._2 + n._3)
let p_3 = n._2*n._2 + n._3*(n._0 + n._1 + n._2)




p*s = h = 1/(1-p^{-s})


[a,b,c,d]
b = 1/a
a = 1/b
c*a = d = a^c
c*b = 1/d = b^c = a^(-c)
b*d = a^(c-1)
a*d = a^(c+1)

[a1,c1]*[a2,c2]
= [
	(1/(a1+1))^(c2-1)+(1/(a2+1))^(c1-1),
	(a1^c2)/a2+(a2^c1)/a1,
]

