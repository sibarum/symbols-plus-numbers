# Strings
@summary Stdlib String — formatNum, split, join, padding, casing, slicing
@category stdlib

The String module provides text manipulation. SPN strings are immutable Unicode-aware sequences. Use ++ for concatenation; everything else is a function call.

show(value) converts any value to its display representation; formatNum(n) is the dedicated form for numbers when you don't want the show() prefix decorations.

## Conversion

show(value) — generic value-to-string.

formatNum(value) — format a Long or Double as a clean numeric string.

## Splitting and joining

split(string, delimiter) — Array of substrings.

lines(string) — split on \n. Convenience for line-oriented processing.

chars(string) — Array of single-character strings.

join(array, delimiter) — concatenate with the delimiter between elements.

## Slicing

substring(string, start, end) — half-open [start, end) substring.

## Predicates

startsWith(string, prefix), endsWith(string, suffix) — boolean checks.

## Transforming

trim(string) — strip leading and trailing whitespace.

toLower(string), toUpper(string) — case conversion.

replace(string, from, to) — replace every literal occurrence of from with to.

repeatStr(string, count) — concatenate count copies of the string.

padLeft(string, width, fill), padRight(string, width, fill) — pad to at least width with the given fill character.

--- example: format-rows.spn
-- Build a tabular row from values with consistent column widths.
import String (formatNum, padLeft, padRight, join)

pure row(string, int, float) -> string = (label, count, ratio) {
    join([
        padRight(label, 12, " "),
        padLeft(formatNum(count), 6, " "),
        padLeft(formatNum(ratio), 8, " "),
    ], " | ")
}

let r1 = row("alpha", 42, 0.13)
let r2 = row("beta",   7, 0.91)
join([r1, r2], "\n")
---

--- example: split-trim-join.spn
-- Clean up a CSV-ish string: split, trim each cell, recombine.
import String (split, trim, join)
import Array (map)

let raw = "  apple ,  banana,cherry , date  "
let cells = map(split(raw, ","), trim)
join(cells, ", ")
-- "apple, banana, cherry, date"
---

--- example: case-and-replace.spn
-- Normalize text and rewrite spelling variants.
import String (toLower, replace, trim)

pure normalize(string) -> string = (s) {
    let lower = toLower(trim(s))
    replace(replace(lower, "color", "colour"), "favor", "favour")
}

normalize("  My Favorite Color is Blue  ")
-- "my favourite colour is blue"
---

--- example: line-numbering.spn
-- Number each line of a multi-line string.
import String (lines, formatNum, padLeft, join)
import Array (enumerate, map)

pure numberLine((int, string)) -> string = (pair) {
    let (i, line) = pair
    padLeft(formatNum(i + 1), 3, " ") ++ "  " ++ line
}

let text = "first\nsecond\nthird"
let numbered = map(enumerate(lines(text)), numberLine)
join(numbered, "\n")
---
